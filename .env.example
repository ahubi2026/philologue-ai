# 필로로그 AI 환경변수 예시 (로컬 개발 시 복사해 .env로 저장, 클라우드 배포 시 Streamlit Secrets 사용)
# 주의: 실제 API 키와 DB 비밀번호가 들어있는 파일은 절대 Git에 올리지 마세요.

# 사용할 LLM 제공자: gemini | openai | demo
PHILOLOGUE_LLM_PROVIDER=gemini

# Gemini 사용 시
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# OpenAI 사용 시
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# 문항당 최대 대화 턴 수
PHILOLOGUE_MAX_TURNS=8

# 교사·연구자 계정 회원가입용 초대 코드 (현장 배포 시 반드시 변경하세요)
PHILOLOGUE_TEACHER_CODE=teacher2026

# 클라우드 DB(Supabase PostgreSQL) 연결 시 아래 주석을 해제하고 URI 입력
# 비워 두면 로컬 SQLite(data/philologue.db)로 동작합니다.
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
